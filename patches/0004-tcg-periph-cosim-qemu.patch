+static void ibexdemo_soc_periph_configure(
+    DeviceState *dev, const IbexDeviceDef *def, DeviceState *parent)
+{
+    const char *path = getenv("IBEXDEMO_COSIM_SOCKET");
+
+    (void)def;
+    (void)parent;
+    if (path && path[0]) {
+        qdev_prop_set_string(dev, "socket-path", path);
+    }
+    qdev_prop_set_chr(dev, "chardev", serial_hd(0));
+}
