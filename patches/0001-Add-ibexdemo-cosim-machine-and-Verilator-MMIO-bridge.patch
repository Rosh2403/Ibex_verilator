+/* ------------------------------------------------------------------------ */
+/* Cosim machine (Verilator GPIO at 0x8000_0000) */
+/* ------------------------------------------------------------------------ */
+
+static void ibexdemo_cosim_machine_init(MachineState *state)
+{
+    DeviceState *board = qdev_new(TYPE_RISCV_IBEXDEMO_BOARD);
+
+    object_property_add_child(OBJECT(state), "board", OBJECT(board));
+    qdev_realize(board, NULL, &error_fatal);
+}
+
+static void ibexdemo_cosim_machine_class_init(ObjectClass *oc, const void *data)
+{
+    MachineClass *mc = MACHINE_CLASS(oc);
+    (void)data;
+
+    mc->desc = "IbexDemo with Verilator cosim GPIO (unix socket)";
+    mc->init = ibexdemo_cosim_machine_init;
+    mc->max_cpus = 1u;
+    mc->default_cpu_type = ibexdemo_soc_devices[IBEXDEMO_SOC_DEV_HART].type;
+    mc->default_ram_id = "ibexdemo.ram";
+    mc->default_ram_size = SRAM_MAIN_SIZE;
+}
+
+static const TypeInfo ibexdemo_cosim_machine_type_info = {
+    .name = TYPE_RISCV_IBEXDEMO_COSIM_MACHINE,
+    .parent = TYPE_MACHINE,
+    .instance_size = sizeof(IbexDemoCosimMachineState),
+    .class_init = ibexdemo_cosim_machine_class_init,
+};
+
+static void ibexdemo_cosim_machine_register_types(void)
+{
+    type_register_static(&ibexdemo_cosim_machine_type_info);
+}
+
+type_init(ibexdemo_cosim_machine_register_types);
