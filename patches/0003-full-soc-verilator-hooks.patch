@@ -19,6 +19,15 @@
 #include <string.h>
 #include <unistd.h>
 
+static void (*cosim_write_byte)(unsigned char);
+static int (*cosim_read_byte)(void);
+
+void uartdpi_set_cosim_callbacks(void (*write_byte)(unsigned char),
+                                  int (*read_byte)(void)) {
+  cosim_write_byte = write_byte;
+  cosim_read_byte = read_byte;
+}
+
 // This keeps the necessary uart state.
 struct uartdpi_ctx {
   char ptyname[64];
@@ -113,6 +122,12 @@ int uartdpi_can_read(void *ctx_void) {
   if (ctx == NULL) {
     return 0;
   }
+  if (cosim_read_byte) {
+    int byte = cosim_read_byte();
+    if (byte < 0) return 0;
+    ctx->tmp_read = (char)byte;
+    return 1;
+  }
   int rv = read(ctx->host, &ctx->tmp_read, 1);
   return (rv == 1);
 }
@@ -130,8 +145,12 @@ void uartdpi_write(void *ctx_void, char c) {
     return;
   }
 
-  rv = write(ctx->host, &c, 1);
-  assert(rv == 1 && "Write to pseudo-terminal failed.");
+  if (cosim_write_byte) {
+    cosim_write_byte((unsigned char)c);
+  } else {
+    rv = write(ctx->host, &c, 1);
+    assert(rv == 1 && "Write to pseudo-terminal failed.");
+  }
 
   if (ctx->log_file) {
     rv = fwrite(&c, sizeof(char), 1, ctx->log_file);
