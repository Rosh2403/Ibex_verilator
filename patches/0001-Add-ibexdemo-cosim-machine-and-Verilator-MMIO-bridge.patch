diff --git a/hw/ibexdemo/ibexdemo_cosim_bridge.c b/hw/ibexdemo/ibexdemo_cosim_bridge.c
new file mode 100644
index 0000000..1e90a7f
--- /dev/null
+++ b/hw/ibexdemo/ibexdemo_cosim_bridge.c
@@ -0,0 +1,218 @@
+/*
+ * QEMU Ibex Demo cosim MMIO bridge (forwards to Verilator socket server)
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/module.h"
+#include "qapi/error.h"
+#include "hw/ibexdemo/ibexdemo_cosim_bridge.h"
+#include "hw/qdev-properties.h"
+#include "hw/qdev-properties-system.h"
+#include "hw/sysbus.h"
+#include "trace.h"
+
+#include <sys/socket.h>
+#include <sys/un.h>
+#include <unistd.h>
+
+#define COSIM_REQ_MAGIC  0x49425843u
+#define COSIM_RESP_MAGIC 0x49425852u
+
+struct CosimMmioReq {
+    uint32_t magic;
+    uint32_t addr;
+    uint8_t we;
+    uint8_t be;
+    uint8_t reserved[2];
+    uint32_t wdata;
+};
+
+struct CosimMmioResp {
+    uint32_t magic;
+    uint32_t rdata;
+};
+
+static bool cosim_bridge_connect(IbexDemoCosimBridgeState *s, Error **errp)
+{
+    if (s->sock_fd >= 0) {
+        return true;
+    }
+
+    int fd = socket(AF_UNIX, SOCK_STREAM, 0);
+    if (fd < 0) {
+        error_setg_errno(errp, errno, "cosim bridge: socket()");
+        return false;
+    }
+
+    struct sockaddr_un addr = { .sun_family = AF_UNIX };
+    if (g_strlcpy(addr.sun_path, s->socket_path, sizeof(addr.sun_path))
+        >= sizeof(addr.sun_path)) {
+        error_setg(errp, "cosim bridge: socket path too long");
+        close(fd);
+        return false;
+    }
+
+    if (connect(fd, (struct sockaddr *)&addr, sizeof(addr)) < 0) {
+        error_setg_errno(errp, errno, "cosim bridge: connect(%s)",
+                         s->socket_path);
+        close(fd);
+        return false;
+    }
+
+    s->sock_fd = fd;
+    return true;
+}
+
+static void cosim_bridge_disconnect(IbexDemoCosimBridgeState *s)
+{
+    if (s->sock_fd >= 0) {
+        close(s->sock_fd);
+        s->sock_fd = -1;
+    }
+}
+
+static uint32_t cosim_bridge_mmio(IbexDemoCosimBridgeState *s, hwaddr offset,
+                                  bool is_write, uint32_t val, unsigned size,
+                                  Error **errp)
+{
+    if (!cosim_bridge_connect(s, errp)) {
+        return 0;
+    }
+
+    uint8_t be = 0;
+    switch (size) {
+    case 1:
+        be = (1u << (offset & 3));
+        break;
+    case 2:
+        be = (3u << (offset & 2));
+        break;
+    case 4:
+        be = 0xFu;
+        break;
+    default:
+        error_setg(errp, "cosim bridge: unsupported access size %u", size);
+        cosim_bridge_disconnect(s);
+        return 0;
+    }
+
+    struct CosimMmioReq req = {
+        .magic = COSIM_REQ_MAGIC,
+        .addr = s->region_base + (uint32_t)offset,
+        .we = is_write ? 1 : 0,
+        .be = be,
+        .wdata = val,
+    };
+
+    if (send(s->sock_fd, &req, sizeof(req), 0) != (ssize_t)sizeof(req)) {
+        error_setg_errno(errp, errno, "cosim bridge: send");
+        cosim_bridge_disconnect(s);
+        return 0;
+    }
+
+    struct CosimMmioResp resp;
+    ssize_t n = recv(s->sock_fd, &resp, sizeof(resp), MSG_WAITALL);
+    if (n != (ssize_t)sizeof(resp)) {
+        error_setg_errno(errp, errno, "cosim bridge: recv");
+        cosim_bridge_disconnect(s);
+        return 0;
+    }
+    if (resp.magic != COSIM_RESP_MAGIC) {
+        error_setg(errp, "cosim bridge: bad response magic");
+        cosim_bridge_disconnect(s);
+        return 0;
+    }
+
+    return resp.rdata;
+}
+
+static uint64_t cosim_bridge_read(void *opaque, hwaddr offset, unsigned size)
+{
+    IbexDemoCosimBridgeState *s = opaque;
+    Error *err = NULL;
+    uint32_t val = cosim_bridge_mmio(s, offset, false, 0, size, &err);
+    if (err) {
+        error_report_err(err);
+    }
+    return val;
+}
+
+static void cosim_bridge_write(void *opaque, hwaddr offset, uint64_t val,
+                               unsigned size)
+{
+    IbexDemoCosimBridgeState *s = opaque;
+    Error *err = NULL;
+    cosim_bridge_mmio(s, offset, true, (uint32_t)val, size, &err);
+    if (err) {
+        error_report_err(err);
+    }
+}
+
+static const MemoryRegionOps cosim_bridge_ops = {
+    .read = cosim_bridge_read,
+    .write = cosim_bridge_write,
+    .endianness = DEVICE_NATIVE_ENDIAN,
+    .valid = {
+        .min_access_size = 1,
+        .max_access_size = 4,
+    },
+};
+
+static void cosim_bridge_init(Object *obj)
+{
+    IbexDemoCosimBridgeState *s = IBEXDEMO_COSIM_BRIDGE(obj);
+
+    memory_region_init_io(&s->mmio, obj, &cosim_bridge_ops, s,
+                          TYPE_IBEXDEMO_COSIM_BRIDGE, 0x1000);
+    sysbus_init_mmio(SYS_BUS_DEVICE(obj), &s->mmio);
+}
+
+static void cosim_bridge_realize(DeviceState *dev, Error **errp)
+{
+    IbexDemoCosimBridgeState *s = IBEXDEMO_COSIM_BRIDGE(dev);
+
+    if (!s->socket_path || !s->socket_path[0]) {
+        error_setg(errp, "cosim bridge: socket-path property required");
+        return;
+    }
+
+    s->sock_fd = -1;
+}
+
+static void cosim_bridge_unrealize(DeviceState *dev)
+{
+    IbexDemoCosimBridgeState *s = IBEXDEMO_COSIM_BRIDGE(dev);
+    cosim_bridge_disconnect(s);
+}
+
+static const Property cosim_bridge_properties[] = {
+    DEFINE_PROP_STRING("socket-path", IbexDemoCosimBridgeState, socket_path),
+    DEFINE_PROP_UINT32("region-base", IbexDemoCosimBridgeState, region_base,
+                      0x80000000u),
+};
+
+static void cosim_bridge_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+
+    dc->realize = cosim_bridge_realize;
+    dc->unrealize = cosim_bridge_unrealize;
+    device_class_set_props(dc, cosim_bridge_properties);
+}
+
+static const TypeInfo cosim_bridge_info = {
+    .name = TYPE_IBEXDEMO_COSIM_BRIDGE,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(IbexDemoCosimBridgeState),
+    .instance_init = cosim_bridge_init,
+    .class_init = cosim_bridge_class_init,
+};
+
+static void cosim_bridge_register_types(void)
+{
+    type_register_static(&cosim_bridge_info);
+}
+
+type_init(cosim_bridge_register_types);
