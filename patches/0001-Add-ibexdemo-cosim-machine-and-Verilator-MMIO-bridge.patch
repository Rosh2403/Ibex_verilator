+/*
+ * QEMU Ibex Demo cosim MMIO bridge (forwards to Verilator socket server)
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef HW_IBEXDEMO_IBEXDEMO_COSIM_BRIDGE_H
